<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Dino Math Race</title>
    <style>
        /* =========================================================
           CSS STYLES & LAYOUT
           ========================================================= */
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@700;900&display=swap');

        :root {
            --primary: #4CAF50;
            --primary-dark: #388E3C;
            --secondary: #2196F3;
            --bg-color: #81C784;
            --text-light: #ffffff;
            --text-dark: #333333;
            --danger: #F44336;
            --warning: #FFC107;
            --glass-bg: rgba(255, 255, 255, 0.95);
            --glass-border: rgba(255, 255, 255, 0.6);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-dark);
            overflow: hidden;
            height: 100vh;
            width: 100vw;
            display: flex;
            justify-content: center;
            align-items: center;
            touch-action: none; /* Cegah scroll di HP */
        }

        #main-menu, #game-over-menu {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(8px);
            z-index: 100;
            transition: opacity 0.3s ease;
        }

        .menu-box {
            background: var(--glass-bg);
            border: 3px solid var(--glass-border);
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.3);
            text-align: center;
            max-width: 90%;
            animation: bounceIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        h1 {
            color: var(--primary-dark);
            font-size: 3rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 0px rgba(255,255,255,0.8);
        }

        h2 { margin-bottom: 20px; color: var(--text-dark); }

        .instructions {
            background: rgba(255, 255, 255, 0.5);
            padding: 15px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 0.95rem;
            text-align: left;
            line-height: 1.4;
            color: #444;
            border: 1px solid rgba(0,0,0,0.1);
        }

        .btn {
            display: inline-block;
            background: var(--primary);
            color: white;
            font-size: 1.5rem;
            font-family: 'Nunito', sans-serif;
            font-weight: 900;
            border: none;
            padding: 15px 30px;
            margin: 10px;
            border-radius: 15px;
            cursor: pointer;
            box-shadow: 0 5px 0 var(--primary-dark);
            transition: all 0.1s;
            text-transform: uppercase;
        }

        .btn:active {
            transform: translateY(5px);
            box-shadow: 0 0px 0 var(--primary-dark);
        }

        .btn.blue { background: var(--secondary); box-shadow: 0 5px 0 #1976D2; }
        .btn.blue:active { box-shadow: 0 0px 0 #1976D2; }

        #global-controls {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 50;
            display: flex;
            gap: 10px;
        }

        .icon-btn {
            background: rgba(255,255,255,0.8);
            border: none;
            border-radius: 50%;
            width: 45px; height: 45px;
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        #game-container {
            display: none; 
            width: 100%;
            height: 100%;
            flex-direction: row; /* Layar Split Vertikal (Kiri-Kanan) Sejati */
        }

        .player-screen {
            position: relative;
            flex: 1;
            height: 100%;
            border-right: 4px solid rgba(0,0,0,0.25);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: opacity 0.3s ease, filter 0.3s ease;
        }
        .player-screen:last-child { border-right: none; }

        /* Meredupkan layar player yang sedang menunggu giliran */
        .player-screen.inactive {
            opacity: 0.45;
            filter: grayscale(50%);
            pointer-events: none !important;
        }

        canvas {
            flex: 1;
            width: 100%;
            display: block;
            cursor: pointer;
        }

        .hud {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 95%;
            display: flex;
            flex-direction: column;
            align-items: center;
            z-index: 10;
            pointer-events: none; /* Pointer events dinonaktifkan di pembungkus luar HUD saja */
        }

        .stats-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            max-width: 500px;
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 6px 15px;
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: bold;
            margin-bottom: 6px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        .lives-container {
            color: #FF5252;
            font-size: 1.1rem;
            letter-spacing: 2px;
        }

        .xp-container {
            display: flex;
            align-items: center;
            gap: 6px;
            flex: 1;
            max-width: 170px;
            margin-left: 10px;
        }

        .xp-text {
            font-size: 0.9rem;
            color: #FFC107;
            font-weight: 900;
            white-space: nowrap;
            min-width: 55px;
            text-align: right;
        }

        .xp-bar-bg {
            background: rgba(255,255,255,0.25);
            border-radius: 6px;
            height: 10px;
            width: 100%;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.4);
        }

        .xp-bar-fill {
            background: var(--secondary);
            height: 100%;
            width: 0%;
            transition: width 0.3s ease;
        }

        .question-panel {
            background: var(--glass-bg);
            border: 3px solid var(--glass-border);
            padding: 10px 15px;
            border-radius: 18px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.2);
            text-align: center;
            width: 100%;
            max-width: 500px;
            pointer-events: auto; /* Aktifkan agar tombol pilihan bisa diklik langsung */
        }

        .question-text {
            font-size: 2rem;
            font-weight: 950;
            color: #1B5E20;
            margin-bottom: 8px;
            text-shadow: 1px 1px 0px white;
        }

        .options-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .option-item {
            background: #E8F5E9;
            border: 2.5px solid #A5D6A7;
            border-radius: 12px;
            padding: 10px 4px;
            font-size: 1.5rem;
            font-weight: 900;
            color: #2E7D32;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: inset 0 -3px 0 rgba(0,0,0,0.1), 0 4px 6px rgba(0,0,0,0.08);
            cursor: pointer;
            transition: transform 0.1s, background-color 0.1s;
        }

        .option-item:hover {
            background-color: #C8E6C9;
        }

        .option-item:active {
            transform: scale(0.95);
        }

        .player-indicator {
            background: var(--primary-dark);
            color: white;
            font-size: 0.75rem;
            padding: 1px 8px;
            border-radius: 6px;
            font-weight: 900;
            align-self: flex-start;
            margin-bottom: 3px;
        }

        @media (max-width: 768px) {
            .question-text { font-size: 1.4rem; margin-bottom: 4px; }
            .option-item { font-size: 1.1rem; padding: 4px 2px; }
            h1 { font-size: 2rem; }
            .stats-bar { padding: 4px 10px; font-size: 0.8rem; }
            .lives-container { font-size: 0.9rem; }
        }

        @keyframes bounceIn {
            0% { transform: scale(0.1); opacity: 0; }
            60% { transform: scale(1.1); opacity: 1; }
            100% { transform: scale(1); }
        }
        
        .shake {
            animation: shake 0.5s;
        }
        @keyframes shake {
            0% { transform: translate(1px, 1px) rotate(0deg); }
            10% { transform: translate(-1px, -2px) rotate(-1deg); }
            20% { transform: translate(-3px, 0px) rotate(1deg); }
            30% { transform: translate(3px, 2px) rotate(0deg); }
            40% { transform: translate(1px, -1px) rotate(1deg); }
            50% { transform: translate(-1px, 2px) rotate(-1deg); }
            60% { transform: translate(-3px, 1px) rotate(0deg); }
            70% { transform: translate(3px, 1px) rotate(-1deg); }
            80% { transform: translate(-1px, -1px) rotate(1deg); }
            90% { transform: translate(1px, 2px) rotate(0deg); }
            100% { transform: translate(1px, -2px) rotate(-1deg); }
        }

        .hidden { display: none !important; }
    </style>
</head>
<body>

    <!-- GLOBAL CONTROLS -->
